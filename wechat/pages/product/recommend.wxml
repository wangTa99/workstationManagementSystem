<view class="recommend-page">
  <!-- 推荐商品列表 -->
  <view class="product-grid">
    <view
      wx:for="{{products}}"
      wx:key="id"
      class="product-item"
      bindtap="onGoodsClick"
      data-id="{{item.id}}"
    >
      <image class="product-image" src="{{item.thumb}}" mode="aspectFill" />
      <view class="product-info">
        <text class="product-name">{{item.name}}</text>
        <text class="product-desc">{{item.description}}</text>
        <view class="product-bottom">
          <text class="product-price">¥{{item.price}}</text>
          <text wx:if="{{item.originalPrice}}" class="product-original">¥{{item.originalPrice}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 没有更多 -->
  <view wx:if="{{finished && products.length > 0}}" class="no-more">
    <text>没有更多了</text>
  </view>
</view>
