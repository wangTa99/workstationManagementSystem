<view class="product-detail">
  <!-- 商品图片 -->
  <swiper class="product-swiper" indicator-dots autoplay circular>
    <swiper-item wx:for="{{product.images}}" wx:key="index">
      <image src="{{item}}" mode="aspectFill" />
    </swiper-item>
  </swiper>

  <!-- 商品信息 -->
  <view class="product-info">
    <view class="price-row">
      <text class="price">¥{{product.price}}</text>
      <text wx:if="{{product.originalPrice}}" class="original-price">¥{{product.originalPrice}}</text>
    </view>
    <text class="product-name">{{product.name}}</text>
    <text class="product-desc">{{product.description}}</text>
  </view>

  <!-- 规格选择 -->
  <view class="spec-section">
    <text class="section-title">选择规格</text>
    <view wx:for="{{specs}}" wx:for-item="spec" wx:key="index" class="spec-group">
      <text class="spec-name">{{spec.name}}</text>
      <view class="spec-values">
        <text
          wx:for="{{spec.values}}"
          wx:for-item="value"
          wx:key="index"
          class="spec-value {{selectedSpec[index] === value ? 'active' : ''}}"
          bindtap="onSpecChange"
          data-spec-index="{{index}}"
          data-value-index="{{index}}"
        >
          {{value}}
        </text>
      </view>
    </view>
  </view>

  <!-- 商品详情 -->
  <view class="detail-section">
    <text class="section-title">商品详情</text>
    <rich-text nodes="{{product.detail}}"></rich-text>
  </view>

  <!-- 底部导航 -->
  <view class="footer-bar">
    <view class="footer-left">
      <view class="action-icon" bindtap="onToggleCollect">
        <text class="icon {{collected ? 'icon-star-fill' : 'icon-star'}}"></text>
        <text class="icon-text">收藏</text>
      </view>
    </view>
    <view class="footer-right">
      <button class="btn-cart" bindtap="onAddCart">加入购物车</button>
      <button class="btn-buy" bindtap="onBuyNow">立即购买</button>
    </view>
  </view>

  <!-- 数量选择 -->
  <view class="num-selector">
    <text>购买数量</text>
    <view class="num-box">
      <text class="num-btn" bindtap="onDecrease">-</text>
      <text class="num-value">{{num}}</text>
      <text class="num-btn" bindtap="onIncrease">+</text>
    </view>
  </view>
</view>
