.comment-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.comment-list {
  padding: 20rpx;
}

.comment-item {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

/* 评论头部 */
.comment-header {
  display: flex;
  align-items: center;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background-color: #f5f5f5;
}

.user-info {
  margin-left: 20rpx;
}

.nickname {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.star-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.star-score {
  font-size: 24rpx;
  color: #ff976a;
}

.comment-time {
  font-size: 24rpx;
  color: #999;
  margin-left: 16rpx;
}

/* 评论内容 */
.comment-content {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

/* 评论图片 */
.comment-images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.comment-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
}

/* 商家回复 */
.comment-reply {
  margin-top: 20rpx;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
}

.reply-label {
  font-size: 26rpx;
  color: #1989fa;
}

.reply-content {
  font-size: 26rpx;
  color: #666;
  margin-left: 10rpx;
}

/* 空状态 */
.empty, .loading {
  text-align: center;
  padding: 100rpx 0;
  font-size: 28rpx;
  color: #999;
}
