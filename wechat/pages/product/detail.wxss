.product-detail {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 商品轮播图 */
.product-swiper {
  height: 750rpx;
  background-color: #fff;
}

.product-swiper image {
  width: 100%;
  height: 100%;
}

/* 商品信息 */
.product-info {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
}

.price {
  font-size: 48rpx;
  color: #ee0a24;
  font-weight: bold;
}

.original-price {
  font-size: 28rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 20rpx;
}

.product-name {
  display: block;
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-top: 20rpx;
}

.product-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-top: 10rpx;
  line-height: 1.5;
}

/* 规格选择 */
.spec-section {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.spec-group {
  margin-bottom: 20rpx;
}

.spec-name {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: block;
}

.spec-values {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.spec-value {
  padding: 12rpx 30rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333;
}

.spec-value.active {
  background-color: #fff0f0;
  color: #ee0a24;
  border: 1rpx solid #ee0a24;
}

/* 商品详情 */
.detail-section {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.detail-section rich-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #666;
}

/* 底部导航 */
.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.footer-left {
  flex: 1;
}

.action-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.icon {
  font-size: 44rpx;
  color: #999;
}

.icon-text {
  font-size: 20rpx;
  color: #666;
  margin-top: 4rpx;
}

.footer-right {
  display: flex;
  gap: 20rpx;
}

.btn-cart, .btn-buy {
  padding: 20rpx 40rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  border: none;
}

.btn-cart {
  background-color: #ff976a;
  color: #fff;
}

.btn-buy {
  background-color: #1989fa;
  color: #fff;
}

.btn-cart::after, .btn-buy::after {
  border: none;
}

/* 数量选择 */
.num-selector {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #fff;
  padding: 30rpx;
  margin-top: 20rpx;
}

.num-box {
  display: flex;
  align-items: center;
}

.num-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background-color: #f5f5f5;
  border-radius: 4rpx;
  font-size: 28rpx;
}

.num-value {
  min-width: 60rpx;
  text-align: center;
  font-size: 28rpx;
}
