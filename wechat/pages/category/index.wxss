.category-page {
  display: flex;
  height: 100vh;
}

/* 左侧分类导航 */
.category-nav {
  width: 180rpx;
  height: 100%;
  background-color: #f5f5f5;
}

.category-item {
  padding: 30rpx 20rpx;
  font-size: 26rpx;
  color: #666;
  text-align: center;
  position: relative;
}

.category-item.active {
  background-color: #fff;
  color: #1989fa;
}

.category-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 4rpx;
  height: 40rpx;
  background-color: #1989fa;
}

/* 右侧商品列表 */
.category-content {
  flex: 1;
  height: 100%;
  background-color: #fff;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx;
}

.product-item {
  width: 50%;
  padding: 10rpx;
  box-sizing: border-box;
}

.product-image {
  width: 100%;
  height: 300rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
}

.product-info {
  padding: 10rpx 0;
}

.product-name {
  display: block;
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-price {
  display: block;
  font-size: 28rpx;
  color: #ee0a24;
  margin-top: 8rpx;
}

.loading, .empty {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}
