<view class="user-page">
  <!-- 用户信息区域 -->
  <view class="user-header">
    <view wx:if="{{isLogin}}" class="user-info">
      <image class="avatar" src="{{userInfo.avatar || '/assets/default-avatar.png'}}" />
      <view class="info">
        <text class="nickname">{{userInfo.nickname || '用户'}}</text>
        <text class="phone">{{userInfo.phone || ''}}</text>
      </view>
    </view>
    <view wx:else class="login-tip" bindtap="onLogin">
      <image class="avatar" src="/assets/default-avatar.png" />
      <text class="login-text">点击登录</text>
    </view>
  </view>

  <!-- 订单入口 -->
  <view class="order-card">
    <view class="card-header">
      <text class="title">我的订单</text>
      <text class="more" bindtap="onOrderClick">全部订单 ></text>
    </view>
    <view class="order-tabs">
      <view class="tab-item" bindtap="onOrderClick" data-status="pending">
        <text class="tab-num">{{orderStats.pending || 0}}</text>
        <text class="tab-text">待支付</text>
      </view>
      <view class="tab-item" bindtap="onOrderClick" data-status="paid">
        <text class="tab-num">{{orderStats.paid || 0}}</text>
        <text class="tab-text">待发货</text>
      </view>
      <view class="tab-item" bindtap="onOrderClick" data-status="shipped">
        <text class="tab-num">{{orderStats.shipped || 0}}</text>
        <text class="tab-text">待收货</text>
      </view>
      <view class="tab-item" bindtap="onOrderClick" data-status="completed">
        <text class="tab-num">{{orderStats.completed || 0}}</text>
        <text class="tab-text">已完成</text>
      </view>
    </view>
  </view>

  <!-- 菜单列表 -->
  <view class="menu-list">
    <view wx:for="{{menuList}}" wx:for-item="group" wx:key="id">
      <view wx:for="{{group}}" wx:key="id" class="menu-item" bindtap="onMenuClick" data-url="{{item.url}}">
        <text class="menu-icon icon-{{item.icon}}"></text>
        <text class="menu-text">{{item.text}}</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>
</view>
