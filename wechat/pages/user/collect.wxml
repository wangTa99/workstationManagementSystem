<view class="collect-page">
  <!-- 收藏列表 -->
  <view class="collect-list">
    <view
      wx:for="{{collectList}}"
      wx:key="id"
      class="collect-item"
    >
      <view class="goods-info" bindtap="onGoodsClick" data-id="{{item.productId}}">
        <image class="goods-image" src="{{item.thumb}}" mode="aspectFill" />
        <view class="goods-detail">
          <text class="goods-name">{{item.name}}</text>
          <text class="goods-desc">{{item.description}}</text>
          <view class="goods-bottom">
            <text class="goods-price">¥{{item.price}}</text>
            <text wx:if="{{item.originalPrice}}" class="goods-original">¥{{item.originalPrice}}</text>
          </view>
        </view>
      </view>
      <view class="goods-actions">
        <text class="action-btn cancel" bindtap="onCancelCollect" data-index="{{index}}">取消收藏</text>
        <text class="action-btn add-cart" bindtap="onAddCart" data-item="{{item}}">加入购物车</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && collectList.length === 0}}" class="empty">
    <image src="/assets/empty/collect.png" mode="aspectFit" />
    <text>暂无收藏商品</text>
    <button class="go-shopping" bindtap="onGoShopping">去逛逛</button>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>
</view>
