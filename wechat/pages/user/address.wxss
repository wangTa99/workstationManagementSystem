.address-page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

.address-list {
  padding: 20rpx;
}

.address-item {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.address-info {
  border-bottom: 1rpx solid #f5f5f5;
  padding-bottom: 20rpx;
}

.consignee-row {
  display: flex;
  align-items: center;
}

.consignee {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.phone {
  font-size: 26rpx;
  color: #666;
  margin-left: 20rpx;
}

.default-tag {
  background-color: #1989fa;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-left: 16rpx;
}

.detail {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-top: 10rpx;
  line-height: 1.4;
}

.address-actions {
  display: flex;
  justify-content: flex-end;
  padding-top: 20rpx;
}

.action-btn {
  font-size: 24rpx;
  margin-left: 30rpx;
}

.action-btn.edit {
  color: #1989fa;
}

.action-btn.set-default {
  color: #07c160;
}

.action-btn.delete {
  color: #ee0a24;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.empty text {
  font-size: 28rpx;
  color: #999;
}

/* 添加按钮 */
.add-btn-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background-color: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.add-btn {
  width: 100%;
  background-color: #1989fa;
  color: #fff;
  font-size: 32rpx;
  padding: 26rpx 0;
  border-radius: 44rpx;
  border: none;
}

.add-btn::after {
  border: none;
}
