.register-page {
  min-height: 100vh;
  background-color: #fff;
  padding: 40rpx 30rpx;
}

/* 表单区域 */
.form-section {
  padding: 0 20rpx;
}

.form-item {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #f5f5f5;
  padding: 30rpx 0;
}

.form-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #333;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.send-btn {
  background-color: #1989fa;
  color: #fff;
  font-size: 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 32rpx;
  border: none;
}

.send-btn.disabled {
  background-color: #ccc;
}

.send-btn::after {
  border: none;
}

/* 用户协议 */
.agreement-row {
  display: flex;
  align-items: center;
  margin-top: 40rpx;
}

.agreement-text {
  font-size: 24rpx;
  color: #666;
  margin-left: 10rpx;
}

.agreement-link {
  font-size: 24rpx;
  color: #1989fa;
}

/* 注册按钮 */
.register-btn {
  width: 100%;
  background-color: #1989fa;
  color: #fff;
  font-size: 32rpx;
  padding: 26rpx 0;
  border-radius: 44rpx;
  margin-top: 40rpx;
  border: none;
}

.register-btn::after {
  border: none;
}
