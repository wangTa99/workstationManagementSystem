.login-page {
  min-height: 100vh;
  background-color: #fff;
}

/* Logo区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0 80rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  background-color: #f5f5f5;
}

.app-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-top: 20rpx;
}

/* 表单区域 */
.form-section {
  padding: 0 60rpx;
}

.form-item {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #f5f5f5;
  padding: 30rpx 0;
}

.form-icon {
  font-size: 40rpx;
  color: #1989fa;
  margin-right: 20rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.send-btn {
  background-color: #1989fa;
  color: #fff;
  font-size: 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 32rpx;
  border: none;
}

.send-btn.disabled {
  background-color: #ccc;
}

.send-btn::after {
  border: none;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  background-color: #1989fa;
  color: #fff;
  font-size: 32rpx;
  padding: 26rpx 0;
  border-radius: 44rpx;
  margin-top: 60rpx;
  border: none;
}

.login-btn::after {
  border: none;
}

/* 切换登录方式 */
.toggle-type {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 40rpx;
  font-size: 26rpx;
  color: #666;
}

.toggle-type text {
  padding: 0 16rpx;
}

.divider {
  color: #ddd;
}
