.coupon-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 标签页 */
.tabs {
  display: flex;
  background-color: #fff;
  padding: 20rpx 0;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  position: relative;
  padding: 10rpx 0;
}

.tab-item.active {
  color: #1989fa;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background-color: #1989fa;
  border-radius: 2rpx;
}

/* 优惠券列表 */
.coupon-list {
  padding: 20rpx;
}

.coupon-item {
  display: flex;
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.coupon-item.used, .coupon-item.expired {
  opacity: 0.6;
}

.coupon-left {
  width: 200rpx;
  background: linear-gradient(135deg, #ff976a, #ff7f50);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 20rpx;
}

.coupon-item.used .coupon-left {
  background: linear-gradient(135deg, #ccc, #bbb);
}

.coupon-value {
  font-size: 56rpx;
  color: #fff;
  font-weight: bold;
}

.coupon-unit {
  font-size: 24rpx;
  color: #fff;
}

.coupon-condition {
  font-size: 22rpx;
  color: #fff;
  margin-top: 10rpx;
}

.coupon-right {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.coupon-name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.coupon-desc {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

.coupon-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
}

.coupon-action {
  display: flex;
  align-items: center;
  padding: 20rpx;
}

.use-btn {
  background-color: #1989fa;
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
}

.coupon-status {
  display: flex;
  align-items: center;
  padding: 20rpx;
}

.coupon-status text {
  font-size: 24rpx;
  color: #999;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.empty text {
  font-size: 28rpx;
  color: #999;
}
