.collect-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.collect-list {
  padding: 20rpx;
}

.collect-item {
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.goods-info {
  display: flex;
  padding: 20rpx;
}

.goods-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
}

.goods-detail {
  flex: 1;
  margin-left: 20rpx;
}

.goods-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-bottom {
  display: flex;
  align-items: baseline;
  margin-top: 20rpx;
}

.goods-price {
  font-size: 32rpx;
  color: #ee0a24;
  font-weight: bold;
}

.goods-original {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 16rpx;
}

.goods-actions {
  display: flex;
  justify-content: flex-end;
  padding: 20rpx;
  border-top: 1rpx solid #f5f5f5;
  gap: 20rpx;
}

.action-btn {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
}

.action-btn.cancel {
  color: #999;
  border: 1rpx solid #ddd;
}

.action-btn.add-cart {
  color: #1989fa;
  border: 1rpx solid #1989fa;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.empty text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.go-shopping {
  background-color: #1989fa;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 60rpx;
  border-radius: 44rpx;
  border: none;
}

.go-shopping::after {
  border: none;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx;
  font-size: 26rpx;
  color: #999;
}
