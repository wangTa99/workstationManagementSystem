<view class="coupon-page">
  <!-- 标签页 -->
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab-item {{activeTab === item.key ? 'active' : ''}}"
      bindtap="onTabChange"
      data-key="{{item.key}}"
    >
      {{item.text}}
    </view>
  </view>

  <!-- 优惠券列表 -->
  <view class="coupon-list">
    <view
      wx:for="{{couponList}}"
      wx:key="id"
      class="coupon-item {{item.status}}"
    >
      <view class="coupon-left">
        <text class="coupon-value">{{item.amount}}</text>
        <text class="coupon-unit">元</text>
        <text class="coupon-condition">满{{item.minAmount}}可用</text>
      </view>
      <view class="coupon-right">
        <text class="coupon-name">{{item.name}}</text>
        <text class="coupon-desc">{{item.description}}</text>
        <text class="coupon-time">{{formatDate(item.startTime)}} - {{formatDate(item.endTime)}}</text>
      </view>
      <view wx:if="{{activeTab === 'available'}}" class="coupon-action">
        <text class="use-btn" bindtap="onUseCoupon" data-coupon="{{item}}">立即使用</text>
      </view>
      <view wx:if="{{item.status === 'used'}}" class="coupon-status">
        <text>已使用</text>
      </view>
      <view wx:if="{{item.status === 'expired'}}" class="coupon-status">
        <text>已过期</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && couponList.length === 0}}" class="empty">
    <image src="/assets/empty/coupon.png" mode="aspectFit" />
    <text>暂无优惠券</text>
  </view>
</view>
