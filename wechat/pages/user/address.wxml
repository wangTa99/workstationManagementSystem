<view class="address-page">
  <!-- 地址列表 -->
  <view class="address-list">
    <view
      wx:for="{{addressList}}"
      wx:key="id"
      class="address-item"
      bindtap="onSelectAddress"
      data-address="{{item}}"
    >
      <view class="address-info">
        <view class="consignee-row">
          <text class="consignee">{{item.consignee}}</text>
          <text class="phone">{{item.phone}}</text>
          <text wx:if="{{item.isDefault}}" class="default-tag">默认</text>
        </view>
        <text class="detail">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</text>
      </view>
      <view class="address-actions">
        <text class="action-btn edit" bindtap="onEditAddress" data-id="{{item.id}}">编辑</text>
        <text wx:if="{{!item.isDefault}}" class="action-btn set-default" bindtap="onSetDefault" data-id="{{item.id}}">设为默认</text>
        <text class="action-btn delete" bindtap="onDeleteAddress" data-id="{{item.id}}">删除</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{addressList.length === 0}}" class="empty">
    <image src="/assets/empty/address.png" mode="aspectFit" />
    <text>暂无收货地址</text>
  </view>

  <!-- 添加地址按钮 -->
  <view class="add-btn-wrap">
    <button class="add-btn" bindtap="onAddAddress">添加收货地址</button>
  </view>
</view>
