<view class="login-page">
  <!-- Logo区域 -->
  <view class="logo-section">
    <image class="logo" src="/assets/logo.png" mode="aspectFit" />
    <text class="app-name">电商小程序</text>
  </view>

  <!-- 登录表单 -->
  <view class="form-section">
    <!-- 手机号 -->
    <view class="form-item">
      <text class="form-icon icon-phone"></text>
      <input
        class="form-input"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>

    <!-- 密码登录 -->
    <view wx:if="{{loginType === 'password'}}" class="form-item">
      <text class="form-icon icon-password"></text>
      <input
        class="form-input"
        password
        placeholder="请输入密码"
        value="{{password}}"
        bindinput="onPasswordInput"
      />
    </view>

    <!-- 验证码登录 -->
    <view wx:if="{{loginType === 'sms'}}" class="form-item">
      <text class="form-icon icon-sms"></text>
      <input
        class="form-input"
        type="number"
        maxlength="6"
        placeholder="请输入验证码"
        value="{{smsCode}}"
        bindinput="onSmsCodeInput"
      />
      <button
        class="send-btn {{sendDisabled ? 'disabled' : ''}}"
        disabled="{{sendDisabled}}"
        bindtap="onSendSms"
      >
        {{countdown > 0 ? countdown + 's' : '获取验证码'}}
      </button>
    </view>

    <!-- 登录按钮 -->
    <button class="login-btn" bindtap="onLogin">登录</button>

    <!-- 切换登录方式 -->
    <view class="toggle-type">
      <text wx-if="{{loginType === 'password'}}" bindtap="onToggleLoginType">验证码登录</text>
      <text wx-else bindtap="onToggleLoginType">密码登录</text>
      <text class="divider">|</text>
      <text bindtap="onRegister">注册账号</text>
    </view>
  </view>
</view>
