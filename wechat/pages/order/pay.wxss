.pay-page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 200rpx;
}

/* 金额区域 */
.amount-section {
  background: linear-gradient(135deg, #1989fa, #409eff);
  color: #fff;
  padding: 60rpx 30rpx;
  text-align: center;
}

.amount-label {
  display: block;
  font-size: 28rpx;
  opacity: 0.9;
}

.amount-value {
  display: block;
  font-size: 72rpx;
  font-weight: bold;
  margin-top: 20rpx;
}

.countdown {
  display: block;
  font-size: 24rpx;
  margin-top: 20rpx;
  opacity: 0.8;
}

/* 订单信息 */
.order-info {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-row .label {
  font-size: 26rpx;
  color: #666;
}

.info-row .value {
  font-size: 26rpx;
  color: #333;
}

/* 支付方式 */
.pay-methods {
  background-color: #fff;
  padding: 30rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  display: block;
}

.method-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.method-item:last-child {
  border-bottom: none;
}

.method-left {
  display: flex;
  align-items: center;
}

.method-icon {
  font-size: 48rpx;
  color: #07c160;
  margin-right: 20rpx;
}

.icon-wechat {
  color: #07c160;
}

.icon-balance {
  color: #ff976a;
}

.method-name {
  font-size: 28rpx;
  color: #333;
}

/* 底部操作 */
.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.pay-btn {
  width: 100%;
  background-color: #1989fa;
  color: #fff;
  font-size: 32rpx;
  padding: 24rpx 0;
  border-radius: 44rpx;
  border: none;
}

.pay-btn::after {
  border: none;
}

.cancel-btn {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #999;
  margin-top: 20rpx;
}
