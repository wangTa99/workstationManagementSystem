<view class="order-list-page">
  <!-- 标签页 -->
  <van-tabs active="{{activeTab}}" bind:change="onTabChange" sticky>
    <van-tab wx:for="{{tabs}}" wx:key="status" title="{{item.text}}" name="{{item.status}}" />
  </van-tabs>

  <!-- 订单列表 -->
  <view class="order-list">
    <view wx:for="{{orders}}" wx:key="id" class="order-item" bindtap="onOrderClick" data-id="{{item.id}}">
      <!-- 订单头部 -->
      <view class="order-header">
        <text class="order-no">订单号：{{item.orderNo}}</text>
        <text class="order-status {{item.status}}">{{item.statusText}}</text>
      </view>

      <!-- 商品列表 -->
      <view class="goods-list">
        <view wx:for="{{item.items}}" wx:for-item="goods" wx:key="id" class="goods-item">
          <image class="goods-image" src="{{goods.thumb}}" mode="aspectFill" />
          <view class="goods-info">
            <text class="goods-name">{{goods.name}}</text>
            <text class="goods-spec">{{goods.spec}}</text>
            <view class="goods-bottom">
              <text class="goods-price">¥{{goods.price}}</text>
              <text class="goods-num">x{{goods.num}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 订单底部 -->
      <view class="order-footer">
        <text class="total-text">合计：¥{{item.totalAmount}}</text>
        <view class="order-actions">
          <button wx:if="{{item.status === 'pending'}}" class="btn-default btn-small" catchtap="onCancel" data-id="{{item.id}}">取消</button>
          <button wx:if="{{item.status === 'pending'}}" class="btn-primary btn-small" catchtap="onPay" data-id="{{item.id}}">去支付</button>
          <button wx:if="{{item.status === 'shipped'}}" class="btn-primary btn-small" catchtap="onConfirm" data-id="{{item.id}}">确认收货</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && orders.length === 0}}" class="empty">
    <image src="/assets/empty/order.png" mode="aspectFit" />
    <text>暂无订单</text>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>
</view>
