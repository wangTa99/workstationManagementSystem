.checkout-page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 收货地址 */
.address-section {
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.address-info {
  flex: 1;
}

.consignee-row {
  display: flex;
  align-items: center;
}

.consignee {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.phone {
  font-size: 26rpx;
  color: #666;
  margin-left: 20rpx;
}

.detail {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-top: 10rpx;
}

.address-empty {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}

.arrow {
  font-size: 28rpx;
  color: #999;
  margin-left: 20rpx;
}

/* 商品列表 */
.goods-section {
  background-color: #fff;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.goods-item {
  display: flex;
  background-color: #fafafa;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.goods-item:last-child {
  margin-bottom: 0;
}

.goods-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
}

.goods-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-spec {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.goods-bottom {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}

.goods-price {
  font-size: 28rpx;
  color: #ee0a24;
}

.goods-num {
  font-size: 26rpx;
  color: #999;
}

/* 优惠券 */
.coupon-section, .remark-section {
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-label {
  font-size: 28rpx;
  color: #333;
}

.section-value {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.coupon-tag {
  background-color: #fff0f0;
  color: #ee0a24;
  padding: 8rpx 16rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
}

.coupon-empty {
  font-size: 26rpx;
  color: #999;
}

.remark-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
}

/* 金额明细 */
.amount-section {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.amount-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.amount-row:last-child {
  margin-bottom: 0;
}

.amount-row .label {
  font-size: 26rpx;
  color: #666;
}

.amount-row .value {
  font-size: 26rpx;
  color: #333;
}

.amount-row .discount {
  color: #ee0a24;
}

/* 底部提交 */
.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.total-info {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 26rpx;
  color: #666;
}

.total-price {
  font-size: 36rpx;
  color: #ee0a24;
  font-weight: bold;
}

.submit-btn {
  background-color: #1989fa;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 60rpx;
  border-radius: 44rpx;
  border: none;
}

.submit-btn::after {
  border: none;
}
