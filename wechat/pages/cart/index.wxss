.cart-page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

.cart-list {
  padding: 20rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.cart-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  margin-left: 20rpx;
  background-color: #f5f5f5;
}

.cart-info {
  flex: 1;
  margin-left: 20rpx;
}

.cart-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cart-spec {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.cart-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.cart-price {
  font-size: 30rpx;
  color: #ee0a24;
}

.cart-num {
  display: flex;
  align-items: center;
}

.num-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 28rpx;
  background-color: #f5f5f5;
  border-radius: 4rpx;
}

.num-value {
  min-width: 48rpx;
  text-align: center;
  font-size: 28rpx;
  padding: 0 8rpx;
}

.cart-delete {
  color: #999;
  font-size: 24rpx;
  margin-left: 20rpx;
}

/* 空状态 */
.cart-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.cart-empty image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.cart-empty text {
  color: #999;
  font-size: 28rpx;
  margin-bottom: 40rpx;
}

/* 底部导航 */
.cart-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.footer-left {
  display: flex;
  align-items: center;
}

.select-all {
  margin-left: 10rpx;
  font-size: 26rpx;
  color: #666;
}

.total-text {
  margin-left: 20rpx;
  font-size: 26rpx;
  color: #666;
}

.total-price {
  font-size: 32rpx;
  color: #ee0a24;
  font-weight: bold;
}

.checkout-btn {
  background-color: #1989fa;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 50rpx;
  border-radius: 44rpx;
  border: none;
}

.checkout-btn::after {
  border: none;
}
