<view class="cart-page">
  <!-- 购物车列表 -->
  <view wx:if="{{cartList.length > 0}}" class="cart-list">
    <view wx:for="{{cartList}}" wx:key="id" class="cart-item">
      <!-- 选择框 -->
      <checkbox checked="{{item.checked}}" bindchange="onCheckedChange" data-index="{{index}}" />

      <!-- 商品图片 -->
      <image class="cart-image" src="{{item.thumb}}" mode="aspectFill" bindtap="onGoodsClick" data-id="{{item.productId}}" />

      <!-- 商品信息 -->
      <view class="cart-info">
        <text class="cart-name">{{item.name}}</text>
        <text class="cart-spec">{{item.spec}}</text>
        <view class="cart-bottom">
          <text class="cart-price">¥{{item.price}}</text>
          <view class="cart-num">
            <text class="num-btn" bindtap="onDecrease" data-index="{{index}}">-</text>
            <text class="num-value">{{item.num}}</text>
            <text class="num-btn" bindtap="onIncrease" data-index="{{index}}">+</text>
          </view>
        </view>
      </view>

      <!-- 删除按钮 -->
      <text class="cart-delete" bindtap="onDelete" data-index="{{index}}">删除</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="cart-empty">
    <image src="/assets/empty/cart.png" mode="aspectFit" />
    <text>购物车是空的</text>
    <button class="btn-primary" bindtap="onGoShopping">去逛逛</button>
  </view>

  <!-- 底部导航 -->
  <view wx:if="{{cartList.length > 0}}" class="cart-footer">
    <view class="footer-left">
      <checkbox checked="{{checkedAll}}" bindchange="onCheckedAll" />
      <text class="select-all" bindtap="onCheckedAll">全选</text>
      <text class="total-text">合计：</text>
      <text class="total-price">¥{{totalPrice}}</text>
    </view>
    <button class="checkout-btn" bindtap="onCheckout">结算</button>
  </view>
</view>
